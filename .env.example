# Tavari webApp — environment variable reference
#
# NOTE: This site is fully client-side. The Supabase anon key and EmailJS
# public key are intentionally public by design and embedded directly in
# app.js / email.js. They cannot be hidden from the browser.
#
# These variables document reserved names in case a build tool or truly
# secret credential (e.g. a Supabase service_role key) is ever introduced.
# Never commit real .env files — see .gitignore.

SUPABASE_URL=
SUPABASE_ANON_KEY=
EMAILJS_PUBLIC_KEY=
